FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 
ENV XDG_CACHE_HOME=/app/.cache
ENV CLOAKBROWSER_CACHE_DIR=/app/.cache/cloakbrowser
ENV CLOAKBROWSER_AUTO_UPDATE=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gcc \
    python3-dev \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxss1 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

CMD ["python", "main.py"]
